# ── Database ──────────────────────────────────────────────
POSTGRES_USER=netsanctum
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=netsanctum
DATABASE_URL=postgresql+asyncpg://netsanctum:change_me_in_production@postgres:5432/netsanctum
DATABASE_URL_SYNC=postgresql+psycopg2://netsanctum:change_me_in_production@postgres:5432/netsanctum

# ── Redis / Celery ────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379/0
CELERY_BROKER_URL=redis://:change_me_redis_password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:change_me_redis_password@redis:6379/1

# ── YouTube / yt-dlp ─────────────────────────────────────
YOUTUBE_POT_PROVIDER_URL=http://youtube-pot:4416
YOUTUBE_YTDLP_PUBLIC_INTERVAL_SECONDS=5
YOUTUBE_YTDLP_AUTH_INTERVAL_SECONDS=10
YOUTUBE_YTDLP_REQUEST_INTERVAL_SECONDS=1
YOUTUBE_YTDLP_BACKOFF_SECONDS=3600

# ── Web Server ────────────────────────────────────────────
HOST_PORT=8000
PUID=1000
PGID=1000
# Modules whose Python and system dependencies are included in the image.
# Use "core" for Auth + Settings only, or a comma-separated module list.
NETSANCTUM_MODULES=default
# External module IDs with matching pyproject optional extras.
NETSANCTUM_EXTERNAL_MODULES=

# Union of hosts browser-enabled modules may request. Per-module policies are narrower.
BROWSER_EGRESS_HOSTS=google.com,googleapis.com,googleusercontent.com,ggpht.com,gstatic.com,recaptcha.net,youtube.com,youtube-nocookie.com,ytimg.com,googlevideo.com
# Comma-separated optional module allowlist. Empty enables all installed modules.
# Auth and Settings are always enabled.
ENABLED_MODULES=
# ── API Key (for external integrations) ──────────────────
MASTER_API_KEY=dev-api-key-change-me
# Legacy migration key. Compose generates the active AES-256-GCM key in a separate volume.
FILE_ENCRYPTION_KEY=dev-file-encryption-key-change-me

# Set these when NetSanctum is exposed through an HTTPS reverse proxy.
PUBLIC_BASE_URL=
SECURE_COOKIES=false
TRUSTED_HOSTS=localhost,127.0.0.1
ALLOW_REMOTE_METADATA_FETCH=false
ACCESS_TOKEN_HASH_PATH=/app/storage/config/access_token.hash
ACCESS_TOKEN_PLAINTEXT_PATH=/app/storage/config/access_token.txt

# ── MIKU assistant runtime ────────────────────────────────
# The agent runtime is the only assistant engine; these feed its per-call providers.
MIKU_LLM_URL=
MIKU_LLM_MODEL=qwen2.5:7b
MIKU_LLM_API_KEY=
MIKU_STT_URL=
MIKU_STT_MODEL=whisper-1
MIKU_STT_API_KEY=
MIKU_TTS_URL=
MIKU_TTS_MODEL=tts-1
MIKU_TTS_API_KEY=
# ── Isolated agent runtime ────────────────────────────────
# Executes cascades outside the web process; start.sh rotates both values.
AGENT_RUNTIME_ENABLED=1
AGENT_RUNTIME_TOKEN=dev-agent-runtime-token-change-me
AGENT_INTERNAL_KEY=dev-agent-internal-key-change-me
# Module whose declared integrations the agent may call.
AGENT_CONSUMER_ID=miku
# Set to 0 for a local model that thinks out loud: on a small model the hidden
# thinking can eat the whole token budget and return an empty answer.
AGENT_LLM_THINKING=1
# ── Server-side voice (optional profile: ./start.sh --voice) ─
# Off by default: with the browser doing its own speech, the server keeps no
# recognition or synthesis model loaded at all. On, it speaks both languages - a
# Russian engine and an English one - and picks by the language of the reply.
MIKU_VOICE_MODEL_DIR=./storage/voice-models
MIKU_STT_MODEL_FILE=ggml-base.bin
VOICE_CPUS=3
VOICE_THREADS=4
WHISPER_VERSION=v1.9.4

# ── Local model (optional profile: ./start.sh --miku-local) ─
# The stack downloads the model on first run and serves it in an isolated container.
MIKU_MODEL_DIR=./storage/models
MIKU_MODEL_FILE=MiniCPM5-2B-Q4_K_M.gguf
MIKU_MODEL_URL=https://huggingface.co/openbmb/MiniCPM5-2B-GGUF/resolve/main/MiniCPM5-2B-Q4_K_M.gguf
# CPU fallback sizing; start.sh raises these to the host core count.
MIKU_LLM_THREADS=4
MIKU_LLM_CPUS=4
MIKU_LLM_CTX=8192

# ── Storage ───────────────────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage
# Required for S3; local storage uses <LOCAL_STORAGE_ROOT>/.work/video-compression by default.
VIDEO_COMPRESSION_WORKDIR=

# S3 (uncomment for production)
# STORAGE_BACKEND=s3
# S3_BUCKET_NAME=my-bucket
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=
